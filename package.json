    "react-dom": "^19.0.0",
    "resend": "^4.0.0",
    "stripe": "^17.7.0",
    "svix": "^1.93.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
